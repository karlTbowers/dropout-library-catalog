---
import '../styles/tokens.css';
import { LIBRARY_REPO } from '../lib/parts';

interface Props {
	title: string;
	description?: string;
	query?: string; // prefill for the header search
}
const { title, description = 'Catalog of the DropOut KiCad library: symbols, footprints, and 3D models.', query = '' } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site">
			<div class="site-inner">
				<a class="wordmark" href={home}>DropOut<span>Parts library</span></a>
				<!-- Searches every part. On the home page the results filter as you type. -->
				<form class="site-search" role="search" action={home} method="get">
					<label class="visually-hidden" for="site-q">Search parts</label>
					<input id="site-q" name="q" type="search" value={query} placeholder="Search MPN, value, manufacturer, footprint…" autocomplete="off" />
					<button type="submit">Search</button>
				</form>
				<nav class="site-nav"><a href={`${home}#categories`}>Categories</a> · <a href={`${home}#families`}>Families</a></nav>
			</div>
		</header>
		<main><slot /></main>
		<footer class="site">
			<div>
				Built from <a href={LIBRARY_REPO}>dropout-kicad-library</a>. Boards use it as a submodule at <code>lib/dropout-kicad-library</code>.
			</div>
		</footer>
		<script>
			// Copy buttons: <button data-copy="text" [data-copied="label shown after copying"]>
			document.addEventListener('click', async (e) => {
				const b = (e.target as HTMLElement).closest('button[data-copy]') as HTMLButtonElement | null;
				if (!b) return;
				const text = b.dataset.copy ?? '';
				let ok = true;
				try {
					await navigator.clipboard.writeText(text);
				} catch {
					// Clipboard API refused (some embedded browsers): fall back to a selected textarea
					const ta = Object.assign(document.createElement('textarea'), { value: text });
					ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
					document.body.append(ta);
					ta.select();
					ok = document.execCommand('copy');
					ta.remove();
				}
				const t = b.textContent;
				b.textContent = ok ? (b.dataset.copied ?? 'Copied') : 'Copy failed';
				setTimeout(() => (b.textContent = t), ok && b.dataset.copied ? 2500 : 1200);
			});
			// "/" jumps to the search box, as on most parts sites
			document.addEventListener('keydown', (e) => {
				const t = e.target as HTMLElement;
				if (e.key !== '/' || e.metaKey || e.ctrlKey || t.closest('input, textarea, select, [contenteditable]')) return;
				e.preventDefault();
				document.getElementById('site-q')?.focus();
			});
		</script>
	</body>
</html>
