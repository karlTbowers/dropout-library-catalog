---
import Base from '../layouts/Base.astro';
import PartBrowser from '../components/PartBrowser.astro';
import { loadFamilies, loadParts, asset } from '../lib/parts';
import { groupTables } from '../lib/families';
import { category, columnsFor } from '../lib/specs';

const parts = loadParts();
const base = import.meta.env.BASE_URL;
const manufacturers = new Set(parts.map((p) => p.manufacturer).filter(Boolean)).size;
// One tile per category, biggest first; the picture is a footprint from that category.
const tiles = [...new Set(parts.map((p) => p.category))]
	.map((key) => {
		const inCat = parts.filter((p) => p.category === key);
		const pic = inCat.find((p) => p.model_glb && p.thumb_svg) ?? inCat.find((p) => p.thumb_svg);
		return { ...category(key), count: inCat.length, svg: pic?.thumb_svg ?? null };
	})
	.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
// Mechanical-part families (McMaster-style pages), from the library's parts/families.yaml.
const families = Object.entries(loadFamilies())
	.map(([key, fam]) => {
		const tables = groupTables(key, fam, parts);
		return { key, title: fam.title, count: tables.reduce((n, t) => n + t.parts.length, 0), svg: tables[0]?.picture ?? null };
	})
	.filter((f) => f.count > 0);
---

<Base title="DropOut parts library">
	{
		parts.length === 0 ? (
			<p class="empty">The library has no parts yet. Parts appear here automatically when they are added to the library.</p>
		) : (
			<>
				<div id="home-intro">
					<div class="hero">
						<h1>DropOut parts library</h1>
						<p class="muted">
							{parts.length} atomic parts from {manufacturers} manufacturers. Each one is a single orderable MPN with its KiCad symbol,
							footprint, and 3D model.
						</p>
					</div>
					<h2 id="categories">Categories</h2>
					<ul class="tiles">
						{tiles.map((t) => (
							<li class="tile">
								<a href={`${base}category/${t.slug}/`}>
									{t.svg ? <img src={asset(t.svg)} alt="" loading="lazy" /> : <span />}
									<span class="tile-text">
										<strong>{t.label}</strong>
										<span>{t.count} part{t.count === 1 ? '' : 's'}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
					{families.length > 0 && (
						<>
							<h2 id="families">Mechanical parts by family</h2>
							<ul class="tiles">
								{families.map((f) => (
									<li class="tile">
										<a href={`${base}family/${f.key}/`}>
											{f.svg ? <img src={asset(f.svg)} alt="" loading="lazy" /> : <span />}
											<span class="tile-text">
												<strong>{f.title}</strong>
												<span>{f.count} part{f.count === 1 ? '' : 's'}</span>
											</span>
										</a>
									</li>
								))}
							</ul>
						</>
					)}
					<h2>All parts</h2>
				</div>
				<PartBrowser parts={parts} columns={columnsFor(null)} search="site" />
			</>
		)
	}
</Base>
